<tal:block
   tal:define="banner python:view.find_banner()"
   i18n:domain="collective.behavior.banner"
   tal:condition="python: banner">

  <div id="portal-banner" class="principal portal-banner banner-monads-super-txt" role="complementary"
     tal:define="checkPermission python:context.restrictedTraverse('portal_membership').checkPermission;
    has_image python:banner and 'banner_image' in banner;
    has_image_right python:banner and 'banner_image_right' in banner;
    has_image_main python:banner and 'banner_image_main' in banner;
    has_image_left python:banner and 'banner_image_left' in banner;
    has_three_images python: has_image_left and has_image_main and has_image_right;
    has_bannertext python: banner.get('banner_title') or banner.get('banner_description') or banner.get('banner_text') or banner.get('banner_linktext');
    show_content_title python: view.show_content_title();
    show_content_title_class python: ' show-content-title' if show_content_title else '';
    circle_color python: view.circle_color() if show_content_title else '';
    inherited python: banner['banner_obj'] != context;
    banner_scale python: banner['banner_size'];
    slider_scale_class python: ' slider-scale bleed' if banner_scale == 'slider' else ' banner-scale';
    ">

    <div class="container"
       tal:condition="python: banner">

      <div class="gigantic"
         tal:define="
        base_classes python:'banner_container portal-banner gigantic' if has_image else 'banner_container banner_without_image portal-banner gigantic';
        full_classes python:base_classes + (show_content_title_class or '') + (slider_scale_class or '')"
         tal:attributes="class full_classes">
        <div class="banner-wrapper">
          <div class="bannerImage"
             tal:condition="python: has_image or has_image_main">
            <img class="bannerImageImage"
               tal:condition="python:has_image"
               tal:attributes="src python: banner['banner_image'] + '/' + banner_scale;
              alt python: banner.get('banner_alt', '')">

            <div class="bannerImageImage three"
               tal:condition="python:has_three_images">

              <img class="right"
                 tal:condition="python:has_image_right"
                 tal:attributes="src python: banner['banner_image_right'] + '/' + banner_scale;
                alt python: banner.get('banner_alt', '')">

              <div class="bannerContent"
                 tal:condition="python: show_content_title">

                <div class="contain-shape" tal:condition="python: circle_color">
                  <div class="hold-shape">
                    <div class="shape-outer">
                      <div class="fg-theme"
                         tal:attributes="style python: 'color: #' + circle_color + ';; opacity: ' + ('0.5' if circle_color == 'f7b98f' else '.9')">
                      <svg class="shape abs-trbl" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                          <circle cx="256" cy="256" r="256" fill="currentColor"/>
                        </svg>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="contentTitle">
                  <h1 tal:content="python: context.title"
                    class="bannerTitle"
                     tal:attributes="style python: 'color: #fff' if circle_color in ['af0917'] else ''" />
                </div>

              </div>

              <img class="main"
                 tal:condition="python:has_image_main"
                 tal:attributes="src python: banner['banner_image_main'] + '/' + banner_scale;
                alt python: banner.get('banner_alt', '')">


              <img class="left"
                 tal:condition="python:has_image_left"
                 tal:attributes="src python: banner['banner_image_left'] + '/' + banner_scale;
                alt python: banner.get('banner_alt', '')">

            </div>

          </div>
        </div>
        <tal:banner_image tal:condition="python: has_image">
          <div class="bannerContent frame"
             tal:condition="python: not show_content_title and has_bannertext">

            <div class="bannerText"
               tal:attributes="class python: 'bannerText ' + banner['textblock_css_class']">

              <h1 class="bannerTitle"
                 tal:condition="python:'banner_title' in banner">
                <span tal:replace="python: banner['banner_title']">Title</span>
              </h1>

              <p class="bannerDescription"
                 tal:condition="python:'banner_description' in banner">
                <tal:def tal:define="banner_desc python:banner['banner_description'];">
                  <span tal:replace="banner_desc" />
                </tal:def>
              </p>

              <div class="bannerLink"
                 tal:condition="python: 'banner_link' in banner">

                <p><a class="context" role="button" target="_blank" href="" title=""
                   tal:attributes="href python: banner['banner_link']; title python: banner['banner_linktext']"
                   tal:content="python: banner['banner_linktext']">
                  Link
                </a></p>

              </div>

              <div class="bannerBody"
                 tal:condition="python:'banner_text' in banner">
                         <span tal:replace="structure python:banner['banner_text']">
                               Text
                         </span>
              </div>

            </div>
          </div>
        </tal:banner_image>

        <tal:banner_image tal:condition="python: has_image">
          <div class="bannerContent"
             tal:condition="python: show_content_title">

            <div class="contain-shape" tal:condition="python: circle_color">
              <div class="hold-shape">
                <div class="shape-outer">
                  <div class="fg-theme"
                   tal:attributes="style python: 'color: #' + circle_color + ';; opacity: ' + ('0.5' if circle_color == 'f7b98f' else '.9')"
                    >
                    <svg class="shape abs-trbl" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="256" cy="256" r="256" fill="currentColor"/>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
            <div class="contentTitle">
              <h1 tal:content="python: context.title"
                class="bannerTitle"
                 tal:attributes="style python: 'color: #fff' if circle_color in ['af0917'] else ''" />
            </div>

          </div>
        </tal:banner_image>

        <div class="bannerEdit"
           tal:condition="python: inherited and checkPermission('Modify portal content', banner['banner_obj'])">
          <a tal:attributes="href python: banner['banner_obj'].absolute_url() + '/@@edit'"
             i18n:translate="">
            Edit inherited banner
          </a>
        </div>

      </div>
    </div>
  </div>

</tal:block>
